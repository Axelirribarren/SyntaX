{
  "name": "syntax",
  "private": true,
  "version": "0.2.0",
  "description": "A compiler for agent environments: one manifest, every runtime, with cost and loss measured before anything is applied.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "syntax": "src/cli.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "doctor": "node src/cli.js doctor",
    "import": "node src/cli.js import",
