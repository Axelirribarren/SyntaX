    "docs": "node scripts/emit-docs.mjs",
    "docs:check": "node scripts/emit-docs.mjs --check",
    "test": "node --test",
    "accept": "node src/cli.js accept"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
